[sub_resource type="Shader" id="Shader_lquwl"]
code = "shader_type canvas_item;

// ⚠️ render_mode에 world_vertex_coords를 추가하여 월드 좌표계를 기준으로 삼습니다.
render_mode world_vertex_coords;

uniform vec2 grid_size = vec2(100.0, 100.0); // 격자 한 칸의 크기
uniform vec4 grid_color : source_color = vec4(1.0, 1.0, 1.0, 0.1); // 격자 색상 및 투명도
uniform float line_thickness = 1.0; // 선 두께

varying vec2 world_pos;

void vertex() {
    // 버텍스(정점) 단계에서 게임 월드의 실제 좌표를 변수에 저장합니다.
    world_pos = VERTEX;
}

void fragment() {
    // 화면 좌표(FRAGCOORD) 대신, 카메라 움직임이 반영된 월드 좌표(world_pos)를 사용합니다.
    vec2 grid = mod(world_pos, grid_size);
    
    // Y축이 뒤집히는 물리적 현상을 보정하기 위한 안전장치
    if (grid.x < 0.0) grid.x += grid_size.x;
    if (grid.y < 0.0) grid.y += grid_size.y;

    // 선 두께 경계선 처리
    if (grid.x < line_thickness || grid.y < line_thickness) {
        COLOR = grid_color;
    } else {
        COLOR = vec4(0.0, 0.0, 0.0, 0.0);
    }
}"

